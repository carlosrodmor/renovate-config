{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    "group:allNonMajor"
  ],
  "timezone": "Europe/Madrid",
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "labels": ["dependencies"],
  "assignees": ["carlosrodmor"],
  "minimumReleaseAge": "3 days",
  "rebaseWhen": "conflicted",
  "platformAutomerge": true,
  "ignoreTests": true,
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "automergeType": "branch",
    "schedule": ["before 6am on monday"]
  },
  "vulnerabilityAlerts": {
    "labels": ["security"],
    "schedule": ["at any time"],
    "minimumReleaseAge": null,
    "automerge": false,
    "dependencyDashboardApproval": false
  },
  "packageRules": [
    {
      "description": ["Patch, pin, digest y minor: merge directo a la rama base, sin abrir PR ni mandar correo"],
      "matchUpdateTypes": ["patch", "pin", "digest", "minor"],
      "automerge": true,
      "automergeType": "branch"
    },
    {
      "description": ["Majors y reemplazos de paquete: nada se abre hasta aprobarlo en el Dependency Dashboard"],
      "matchUpdateTypes": ["major", "replacement"],
      "automerge": false,
      "dependencyDashboardApproval": true
    },
    {
      "description": ["zone.js solo se mueve cuando se mueve Angular: cada version de @angular/core fija un peer distinto (~0.14 en v18, ~0.15 en v19) y el bump suelto rompe el package-lock con ERESOLVE. Se permiten patches."],
      "matchPackageNames": ["zone.js"],
      "matchUpdateTypes": ["major", "minor"],
      "enabled": false
    },
    {
      "description": ["eslint-plugin-react-refresh 0.5+ exige ESLint 9 o 10; retenido hasta migrar Portfolio a flat config"],
      "matchPackageNames": ["eslint-plugin-react-refresh"],
      "allowedVersions": "<0.5.0"
    }
  ]
}
