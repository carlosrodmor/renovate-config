{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    "group:allNonMajor"
  ],
  "timezone": "Europe/Madrid",
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "labels": ["dependencies"],
  "assignees": ["carlosrodmor"],
  "minimumReleaseAge": "3 days",
  "rebaseWhen": "conflicted",
  "platformAutomerge": true,
  "ignoreTests": true,
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "automergeType": "branch",
    "schedule": ["before 6am on monday"]
  },
  "vulnerabilityAlerts": {
    "labels": ["security"],
    "schedule": ["at any time"],
    "minimumReleaseAge": null,
    "automerge": false,
    "dependencyDashboardApproval": false
  },
  "packageRules": [
    {
      "description": ["Patch, pin, digest y minor: merge directo a la rama base, sin abrir PR ni mandar correo"],
      "matchUpdateTypes": ["patch", "pin", "digest", "minor"],
      "automerge": true,
      "automergeType": "branch"
    },
    {
      "description": ["Majors: nada se abre hasta que lo apruebes en el Dependency Dashboard"],
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "dependencyDashboardApproval": true
    }
  ]
}
